{
  "buildCommand": "pnpm install && pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/landing-page/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  }
}
